# -----------------------------------------------------------------------------
# CONFIGURAÇÃO DE BANCO DE DADOS POSTGRESQL (SUPABASE / NEON)
# -----------------------------------------------------------------------------
# Substitua pelas URLs de conexão geradas ao criar a conta no Supabase.
# Enquanto estas variáveis não forem preenchidas, o site usará o armazenamento local (.data-store.json).

# Conexão Pooler (Transaction Pooler - Porta 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão Direta para Migrações / Schema (Direct Connection - Porta 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# CHAVE DE CRIPTOGRAFIA PII (DADOS PESSOAIS DE CLIENTES)
# -----------------------------------------------------------------------------
# Chave de 32 bytes em hexadecimal (64 caracteres) para criptografia AES-256
PII_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# -----------------------------------------------------------------------------
# AUTENTICAÇÃO DO PAINEL DO ADMINISTRADOR & INTEGRAÇÃO ASAAS
# -----------------------------------------------------------------------------
ADMIN_PASSWORD="suasenhaforteaqui"
ADMIN_2FA_SECRET="LAVAUJATOBANHOET"
ASAAS_API_KEY=""
ASAAS_IS_SANDBOX="true"
